{
  "manifest_version": 3,
  "name": "My Extension",
  "version": "1.0.0",
  "description": "팝업, 사이드 패널, 개발자 도구를 제공하는 확장 프로그램",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "storage",
    "sidePanel"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_title": "My Extension",
    "default_popup": "popup/popup.html"
  },

  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },

  "devtools_page": "devtools/devtools.html",

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "content_scripts": [
    {
      "matches": ["https://example.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}